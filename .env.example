# Copiá este archivo como .env y completá los valores.
# El .env NO se sube al repositorio (está en .gitignore).

# Base de datos — estos valores sirven tal cual con Docker (docker-compose.yml)
DB_HOST=db
DB_PORT=3306
DB_NAME=cooki
DB_USER=cooki
DB_PASS=cooki
DB_ROOT_PASS=root

# Con XAMPP / Laragon (sin Docker) normalmente es:
# DB_HOST=127.0.0.1
# DB_USER=root
# DB_PASS=

# Entorno: desarrollo | produccion  (en produccion no se muestran detalles de errores)
APP_ENV=desarrollo
# En el hosting, si tiene certificado (https), poné 1 para que todo vaya por https
FORZAR_HTTPS=0

# Dirección pública del sitio, para los enlaces de los correos (recuperar la contraseña).
# En desarrollo puede quedar vacía; en el hosting conviene ponerla, por ejemplo https://cooki.mi-hosting.com
APP_URL=

# Correo del formulario de contacto (dirección simulada del sitio).
# Con Docker los correos se ven en Mailpit: http://localhost:8025
MAIL_CONTACTO=contacto@cooki.test
MAIL_REMITENTE=no-responder@cooki.test

# Servidor de correo (cliente SMTP propio, src/Smtp.php). Si MAIL_HOST queda vacío se usa mail() de PHP.
# Con Docker: mailpit, puerto 1025, sin seguridad ni usuario (ya está así).
# Con XAMPP sin Mailpit: dejá MAIL_HOST vacío (los correos no salen, pero todo lo demás anda).
# En el hosting (InfinityFree bloquea mail()): Gmail con la cuenta del proyecto y una contraseña de aplicación
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SEGURIDAD=tls   (o 465 con ssl)
#   MAIL_USUARIO=la cuenta de Gmail  MAIL_CONTRASENA=la contraseña de aplicación de 16 letras, sin espacios
#   MAIL_REMITENTE=la misma cuenta de Gmail (Gmail cambia cualquier otro remitente por esa)
# Para comprobarlo: Administración → Correo → "Mandarme un correo de prueba". Pasos en docs/publicar.md.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SEGURIDAD=ninguna
MAIL_USUARIO=
MAIL_CONTRASENA=

# IA (incremento 3): recetas con lo que tenés, adaptar recetas y reemplazos. Usa Gemini con el plan gratuito.
# Sin IA_CLAVE, la IA queda apagada y el resto del sitio anda igual.
# La clave se saca en https://aistudio.google.com/apikey con la cuenta de Gmail del proyecto.
# Google retira modelos cada tanto: si Administración → IA dice "El modelo configurado ya no existe", cambiá IA_MODELO.
IA_PROVEEDOR=gemini
IA_CLAVE=
IA_MODELO=gemini-3.5-flash-lite
IA_URL=https://generativelanguage.googleapis.com/v1beta
# Segundos que se espera a la IA (el hosting corta cada página a los 20 s)
IA_TIMEOUT=12
# Pedidos por día: de cada usuario y de todo el sitio (por debajo del cupo gratuito de Google)
IA_LIMITE_USUARIO_DIA=5
IA_LIMITE_GLOBAL_DIA=200
